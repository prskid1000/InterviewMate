# Copy this file to .env and fill in the key(s) you have.
# All have FREE tiers — you only need ONE to start.
# Providers reference these via api_key_env in config.yaml; you can also paste
# a key directly into a provider row in Settings.

# Gemini — recommended, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — free, generous limits: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (optional): https://openrouter.ai/keys
OPENROUTER_API_KEY=
